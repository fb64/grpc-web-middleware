{
  "name": "grpc-web-middleware",
  "version": "1.0.0",
  "description": "grpc-web to gRPC proxy for Node.js: a fetch-style handler (Hono...) and a (req, res, next) middleware (node:http, Express, Koa...)",
  "keywords": [
    "grpc",
    "grpc-web",
    "proxy",
    "middleware",
    "hono",
    "express"
  ],
  "license": "MIT",
  "author": "Florian Bernard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fb64/grpc-web-middleware.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-web": "^2.3.0",
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
